# 数据库（端口 5433 —— 与 SlideAgentPro 分开）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/myrag

# ChromaDB（端口 8002 —— 与 SlideAgentPro 分开）
CHROMA_HOST=localhost
CHROMA_PORT=8002

# ===========================================
# LLM 提供商："gemini" | "ollama"
# 切换提供商：注释掉一个块，取消注释另一个块
# ===========================================

# --- Gemini（已启用） ---
LLM_PROVIDER=gemini
GOOGLE_AI_API_KEY=your-gemini-api-key
# LLM_MODEL_FAST=gemini-3.1-flash-lite-preview（推荐 —— 快速且便宜）
LLM_MODEL_FAST=gemini-2.5-flash

# Gemini 3.x+ 的思考级别："minimal" | "low" | "medium" | "high"
# Gemini 2.5 会自动使用 thinking_budget_tokens（此设置会被忽略）
LLM_THINKING_LEVEL=medium

# 聊天的最大输出令牌数（包含思考令牌）
# Gemini 2.5 Flash：最高 8192，Gemini 3.1 Flash-Lite：最高 65536
LLM_MAX_OUTPUT_TOKENS=8192

# --- Ollama（未启用 —— 取消注释即可使用，同时注释掉上面的 Gemini） ---
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# 多模态模型（推荐）
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_MODEL=gemma3:12b
# 仅文本模型
# OLLAMA_MODEL=kamekichi128/qwen3-4b-instruct-2507
# 为 Ollama 启用思考模式（默认：false —— 可降低 qwen3.5 等思考模型的延迟）
# OLLAMA_ENABLE_THINKING=false

# ===========================================
# 知识图谱向量化（可以与 LLM 提供商不同）
# ===========================================

# --- 知识图谱向量化：Gemini（已启用） ---
KG_EMBEDDING_PROVIDER=gemini
KG_EMBEDDING_MODEL=gemini-embedding-001
KG_EMBEDDING_DIMENSION=3072

# --- 知识图谱向量化：Ollama（未启用） ---
# KG_EMBEDDING_PROVIDER=ollama
# KG_EMBEDDING_MODEL=bge-m3
# KG_EMBEDDING_DIMENSION=1024

# --- 知识图谱向量化：Sentence-Transformers（未启用 —— 完全本地，无需 API） ---
# KG_EMBEDDING_PROVIDER=sentence_transformers
# KG_EMBEDDING_MODEL=BAAI/bge-m3
# KG_EMBEDDING_DIMENSION=1024

# MYRAG 流水线（全部可选，显示的是默认值）
MYRAG_ENABLED=true
MYRAG_ENABLE_KG=true
# 知识图谱的全局默认语言（可在界面中按工作区覆盖）
MYRAG_KG_LANGUAGE=English
MYRAG_KG_ENTITY_TYPES=["Organization","Person","Product","Location","Event","Financial_Metric","Technology","Date","Regulation"]
# 文档解析器："docling"（默认，GPU 占用高）或 "marker"（更轻量约 2-4GB，数学/LaTeX 更好）
# MYRAG_DOCUMENT_PARSER=docling
# MYRAG_MARKER_USE_LLM=false

MYRAG_ENABLE_IMAGE_EXTRACTION=true
MYRAG_ENABLE_IMAGE_CAPTIONING=true
MYRAG_EMBEDDING_MODEL=BAAI/bge-m3
MYRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MYRAG_CHUNK_MAX_TOKENS=512
MYRAG_VECTOR_PREFETCH=20
MYRAG_RERANKER_TOP_K=8
MYRAG_MIN_RELEVANCE_SCORE=0.15

# 处理超时 —— 超过此分钟数后，过期文档自动恢复为 FAILED 状态
# MYRAG_PROCESSING_TIMEOUT_MINUTES=10

# 入库前去重（噪声过滤 + 内容哈希 + 近似重复检测）
MYRAG_DEDUP_ENABLED=true
MYRAG_DEDUP_MIN_CHUNK_LENGTH=50
MYRAG_DEDUP_NEAR_THRESHOLD=0.85

# CORS 跨域配置
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]
